# Leave empty for Rule-based Demo Mode. No API calls are made without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25
# Relative SQLite paths are resolved from the repository root.
DATABASE_URL=sqlite:///./data/helpdesk.db
BACKEND_URL=http://127.0.0.1:8000
# Candidate hints only; never auto-merge tickets. Allowed range: 0.5–1.0.
DUPLICATE_SIMILARITY_THRESHOLD=0.78
SLA_WARNING_HOURS=2
